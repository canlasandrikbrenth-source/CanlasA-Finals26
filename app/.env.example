# Local laptop run only. Copy to app/.env (git-ignored). On AWS these come from Parameter Store.
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
CREDS_KEY=generate-with-openssl-rand-hex-32
CREDS_IV=generate-with-openssl-rand-hex-16
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-32
GATEWAY_TOKEN=generate-with-openssl-rand-hex-32
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=llama-3.3-70b-versatile
APP_VERSION=local
# Local only. The gateway reads this from Parameter Store on AWS.
MODEL_API_KEY=
CONTENT_DIR=/content
ALLOW_REGISTRATION=true
